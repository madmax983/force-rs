        // Simulates `handle_soft_refresh` on a failure (PATCHED)
        fn handle_soft_refresh_fail(&self, valid_token: usize) -> Result<usize, ()> {
            let clear_count_at_start = self.state.read().unwrap().clear_count;

            let Ok(_lock) = self.refresh_lock.try_lock() else {
                return self.latest_token_or(valid_token, clear_count_at_start);
            };

            let clear_count = {
                let state = self.state.read().unwrap();
                if state.token.is_some() && state.token.unwrap() > valid_token {
                    return Ok(state.token.unwrap());
                }
                state.clear_count
            };

            if clear_count != clear_count_at_start {
                return Err(());
            }

            // Simulating failure of authenticator.refresh()
            thread::yield_now();

            // Return latest or valid token
            self.latest_token_or(valid_token, clear_count_at_start)
        }
